<Window x:Class="ScrollWM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrollWM — Experimental Preview"
        Width="950" Height="780" MinWidth="760" MinHeight="620"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1E293B"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#64748B" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5F9" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E2E8F0" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#2563EB" /></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#94A3B8" /><Setter Property="Background" Value="#F1F5F9" />
          <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1D4ED8" /><Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1E40AF" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1E3A8A" /></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#94A3B8" /><Setter Property="Background" Value="#F1F5F9" />
          <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D5DDE7" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style x:Key="WindowItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5F9" /></Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#EFF6FF" /><Setter Property="BorderBrush" Value="#BFDBFE" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#2563EB" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StripItem" TargetType="ListBoxItem" BasedOn="{StaticResource WindowItem}">
      <Setter Property="Focusable" Value="False" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
        <DataTrigger Binding="{Binding Focused}" Value="True">
          <Setter Property="Background" Value="#EFF6FF" /><Setter Property="BorderBrush" Value="#BFDBFE" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>
  <TabControl Margin="12" Background="White" BorderBrush="#D5DDE7">
    <TabItem Header="Scrolling strip" Padding="12,7">
      <Grid Margin="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="22" Height="22" Stretch="Uniform" Fill="#1D4ED8" Margin="0,0,10,0"
                  Data="M0,0 H5 V18 H0 Z M8,0 H13 V18 H8 Z M16,0 H21 V18 H16 Z" />
            <TextBlock Text="ScrollWM" FontSize="22" FontWeight="SemiBold" />
            <Border x:Name="StripStateBadge" Margin="12,0,0,0" Padding="8,3" CornerRadius="10" VerticalAlignment="Center">
              <TextBlock x:Name="StripStateText" FontSize="12" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="StartStripButton" Content="Start strip" Style="{StaticResource PrimaryButton}" Click="StartStripClick" />
            <Button x:Name="ResumeStripButton" Content="Resume" Style="{StaticResource PrimaryButton}" Click="ResumeStripClick" />
            <Button x:Name="PauseStripButton" Content="Pause &amp; restore" Margin="0" Click="PauseStripClick"
                    ToolTip="Restore original window positions. Ctrl+Alt+P pauses or resumes." />
          </WrapPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
          <Border x:Name="ReadinessPanel" Padding="10,8" CornerRadius="4" Background="#F1F5F9">
            <TextBlock x:Name="StripReadiness" TextWrapping="Wrap" />
          </Border>
          <CheckBox x:Name="AutoEnrollCheck" Margin="0,10,0,0" Content="Add new windows automatically"
                    ToolTip="Adds newly opened eligible windows during this session. Pause the strip to change this option." />
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AvailableHeading" Text="Available windows" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="SelectionHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Click="StripRefreshClick" Margin="8,0,0,0" AutomationProperties.Name="Refresh" ToolTip="Find eligible open windows and select them all.">
                <StackPanel Orientation="Horizontal">
                  <Path Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.5" Data="M13,6 A5,5 0 1 0 12,10 M13,1 V6 H8" />
                  <TextBlock Text="Refresh" />
                </StackPanel>
              </Button>
            </Grid>
            <Grid Grid.Row="1">
              <ListBox x:Name="StripCandidates" SelectionMode="Extended" ItemContainerStyle="{StaticResource WindowItem}"
                       SelectionChanged="StripSelectionChanged" AutomationProperties.Name="Available windows">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" FontWeight="SemiBold" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="AvailableEmpty" Margin="24" Foreground="{StaticResource Muted}" TextAlignment="Center"
                         TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
              <Button x:Name="AddStripButton" Content="Add selected" Click="AddStripClick" />
              <Button x:Name="AddOpenStripButton" Content="Add open windows" Margin="0" Click="AddOpenStripClick"
                      ToolTip="Find and add all eligible windows outside the strip." />
            </WrapPanel>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8" MinHeight="36">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StripHeading" Text="Strip" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="FocusHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                <ComboBox x:Name="MonitorBox" Width="140" MinHeight="32" FontSize="12" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectionChanged="MonitorSelectionChanged" AutomationProperties.Name="Monitor"
                          ToolTip="{Binding SelectedItem.Details, RelativeSource={RelativeSource Self}}" />
                <Button x:Name="TransferMonitorButton" Margin="6,0,0,0" Click="TransferMonitorClick"
                        ToolTip="Move focused window to the next monitor · Ctrl+Alt+M" AutomationProperties.Name="Move to next monitor">
                  <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.4" Data="M0,0 H8 V4 M8,9 V13 H0 V0 M6,6 H14 M11,3 L14,6 L11,9" />
                </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
              <ListBox x:Name="StripOrder" ItemContainerStyle="{StaticResource StripItem}" AutomationProperties.Name="Strip order">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Details}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Path Width="10" Height="10" Stretch="Uniform" Fill="#1D4ED8" Data="M0,0 L7,5 L0,10 Z">
                        <Path.Style><Style TargetType="Path"><Setter Property="Opacity" Value="0" />
                          <Style.Triggers><DataTrigger Binding="{Binding Focused}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers>
                        </Style></Path.Style>
                      </Path>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{Binding WidthLabel}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="StripEmpty" Text="No windows in the strip.&#10;Start the strip to arrange selected windows."
                         Margin="24" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                         VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
              <Button x:Name="PreviousStripButton" Content="Previous" Click="PreviousStripClick" ToolTip="Focus previous window · Ctrl+Alt+Left" />
              <Button x:Name="NextStripButton" Content="Next" Click="NextStripClick" ToolTip="Focus next window · Ctrl+Alt+Right" />
              <Button x:Name="MoveLeftStripButton" Click="MoveLeftStripClick" ToolTip="Move focused window left · Ctrl+Alt+Shift+Left" AutomationProperties.Name="Move left">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M7,1 L1,7 L7,13 M1,7 H14" />
              </Button>
              <Button x:Name="MoveRightStripButton" Click="MoveRightStripClick" ToolTip="Move focused window right · Ctrl+Alt+Shift+Right" AutomationProperties.Name="Move right">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M7,1 L13,7 L7,13 M0,7 H13" />
              </Button>
              <Button x:Name="WidthStripButton" Content="Width" Margin="0" Click="WidthStripClick" ToolTip="Cycle width: third, half, two thirds, full · Ctrl+Alt+W" />
            </WrapPanel>
          </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
          <Border x:Name="StripMessagePanel" Padding="10,8" Margin="0,0,0,10" CornerRadius="4" Background="#F1F5F9">
            <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="StripStatus" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <Expander Header="Shortcuts &amp; window behavior" Foreground="{StaticResource Muted}" FontSize="12">
            <TextBlock Margin="20,6,0,8" TextWrapping="Wrap"
                       Text="Ctrl+Alt+Left/Right: focus · Add Shift: reorder · Ctrl+Alt+W: width · Ctrl+Alt+P: pause or resume · Ctrl+Alt+M: move to next monitor&#10;Edge windows keep their widths and sit behind fully visible windows. Focus an edge window to reveal it.&#10;Resize a window to change its width. Drag within a monitor to detach it. Drag to another monitor to move it to that strip." />
          </Expander>
          <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#475569" Text="Emergency restore · Ctrl+Alt+Shift+Esc" />
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="Position probes" Padding="12,7">
      <Grid Margin="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Position probes" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="Capture windows before testing their position. Restore all returns their original positions." />
          <TextBlock x:Name="DisplayText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
          <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" />
          <Button x:Name="CaptureButton" Content="Capture selected" Click="CaptureClick" />
          <Button Content="Restore all" Click="RestoreClick" />
          <Button Content="Exit keeping recovery" Margin="0" Click="ExitKeepingRecoveryClick" />
        </WrapPanel>
        <ListBox x:Name="WindowList" Grid.Row="2" SelectionMode="Extended" DisplayMemberPath="Label"
                 AutomationProperties.Name="Eligible application windows" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <TextBlock Text="After capture, select one window to move." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
          <WrapPanel Margin="0,8,0,0">
            <ComboBox x:Name="PositionBox" Width="150" Margin="0,0,8,0" MinHeight="32" AutomationProperties.Name="Probe position" />
            <ComboBox x:Name="WidthBox" Width="125" Margin="0,0,8,0" MinHeight="32" AutomationProperties.Name="Column width" />
            <Button x:Name="ProbeButton" Content="Move selected" Click="ProbeClick" />
            <Button x:Name="RevealButton" Content="Reveal &amp; focus" Margin="0" Click="RevealClick" />
          </WrapPanel>
          <TextBlock Margin="0,10,0,0" FontSize="12" Text="Emergency restore · Ctrl+Alt+Shift+Esc" />
        </StackPanel>
        <Border Grid.Row="4" Background="#F1F5F9" Padding="10" Margin="0,12,0,0" CornerRadius="4">
          <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
